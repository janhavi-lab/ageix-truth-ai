# Supabase — copy to .env and fill with your project values
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth: enable in Supabase Auth → Providers → Google
# Add redirect URL: http://localhost:5173/auth/callback (and your production URL)
